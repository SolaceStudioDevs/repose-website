---
interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: object | object[];
}

// The link preview shown when a page is shared (1200x630): the ocean photo, the app icon,
// "Rest, on your terms." and two app screenshots. Pages can pass their own.
const { title, description, image = "/og-image.jpg", jsonLd } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://reposesleep.net");
const siteName = "Repose: Sleep Sounds";
// The site name is added to the end unless the title already names Repose, or
// the result would be longer than the ~60 characters Google shows.
const suffixed = `${title} — ${siteName}`;
const fullTitle = title.includes("Repose") || suffixed.length > 60 ? title : suffixed;
const ldItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ldJson = ldItems.length
  ? JSON.stringify({ "@context": "https://schema.org", "@graph": ldItems }).replace(/</g, "\u003c")
  : "";
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content="website" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={new URL(image, Astro.site ?? "https://reposesleep.net")} />
{image === "/og-image.jpg" && <meta property="og:image:width" content="1200" />}
{image === "/og-image.jpg" && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content="Repose: Sleep Sounds. Rest, on your terms." />
<meta property="og:site_name" content={siteName} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site ?? "https://reposesleep.net")} />
{ldJson && <script type="application/ld+json" set:html={ldJson} />}
