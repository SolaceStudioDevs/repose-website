---
/*
  App Store is live; Play Store is still pending closed testing — see
  website_handoff.md cross-links section. These are styled placeholders,
  not the official Apple/Google badge SVGs. Swap the Google Play one for
  the real badge + href once that store URL lands too.
*/
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class={`flex flex-wrap items-center gap-3 ${className}`}>
  <a
    href="https://apps.apple.com/app/repose-sleep-sounds/id6762325488"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-3 rounded-xl border border-white/10 bg-white px-5 py-3 text-[#1a1a2e] shadow-lg transition hover:opacity-90"
  >
    <svg viewBox="0 0 24 24" class="h-7 w-7 fill-current" aria-hidden="true">
      <path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.53-3.24 0-1.44.66-2.2.47-3.06-.4C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8.94-.19 1.83-.87 3.05-.72 1.79.14 3.15 1.03 3.94 2.42-3.48 2.08-2.87 6.68.29 7.98-.63 1.63-1.44 3.24-2.36 4.49zM12.03 7.25c-.13-1.98 1.48-3.62 3.34-3.75.28 2.05-1.5 3.75-3.34 3.75z"/>
    </svg>
    <span class="text-left leading-tight">
      <span class="block text-xs text-gray-500">Download on the</span>
      <span class="block text-base font-bold">App Store</span>
    </span>
  </a>

  <a
    href="#"
    rel="noopener noreferrer"
    aria-disabled="true"
    class="inline-flex items-center gap-3 rounded-xl border border-white/10 bg-white px-5 py-3 text-[#1a1a2e] opacity-90 shadow-lg transition hover:opacity-100"
  >
    <svg viewBox="0 0 24 24" class="h-7 w-7 fill-current" aria-hidden="true">
      <path d="M3.6 2.8c-.3.3-.5.8-.5 1.4v15.6c0 .6.2 1.1.5 1.4l.1.1L13 12l-9.3-9.3-.1.1zM16 15l-2.5-2.5L4.2 21.7c.4.3.9.3 1.4.1L16 15zm3.4-4.6L16.7 9 14 11.7 16.7 14.4l2.7-1.4c.8-.5.8-1.7 0-2.2v-.2zM4.2 2.3L13.5 11.6 16 9.1 5.6 2.2c-.5-.2-1-.2-1.4.1z"/>
    </svg>
    <span class="text-left leading-tight">
      <span class="block text-xs text-gray-500">Coming soon to</span>
      <span class="block text-base font-bold">Google Play</span>
    </span>
  </a>
</div>
