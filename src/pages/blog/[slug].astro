---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const postUrl = new URL(`/blog/${post.id}/`, Astro.site ?? "https://reposesleep.net").href;
const blogPosting = {
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString().slice(0, 10),
  url: postUrl,
  mainEntityOfPage: postUrl,
  image: new URL("/og-image.jpg", Astro.site ?? "https://reposesleep.net").href,
  keywords: post.data.tags.join(", "),
  author: { "@type": "Organization", name: "Solace Studios", url: "https://reposesleep.net/about/" },
  publisher: { "@type": "Organization", name: "Solace Studios", logo: { "@type": "ImageObject", url: "https://reposesleep.net/icon-192.png" } },
};

const dateFormatter = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<Base
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.seoDescription ?? post.data.description}
  jsonLd={blogPosting}
>
  <article class="mx-auto max-w-3xl px-6 py-20 sm:py-28">
    <header class="reveal mb-12">
      <a href="/blog" class="text-sm font-bold text-repose-muted transition hover:text-repose-text">← Blog</a>
      <p class="mt-6 text-xs font-bold uppercase tracking-widest text-repose-muted">
        {dateFormatter.format(post.data.pubDate)}
      </p>
      <h1 class="mt-3 text-4xl font-black leading-tight sm:text-5xl">{post.data.title}</h1>
      {post.data.tags.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="rounded-full border border-repose-border px-3 py-1 text-xs font-semibold text-repose-muted">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose-repose reveal">
      <Content />
    </div>
  </article>
</Base>
